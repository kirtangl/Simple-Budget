TZ=Australia/Brisbane
SECURE_COOKIES=false
# Only needed to run a second copy (e.g. a test one) on the same machine:
# CONTAINER_NAME=simple-budget-test
# HOST_PORT=3001
# APP_CHANNEL=test

# Only for a private fork: where to look for new versions (Settings → Updates),
# and a fine-grained token with read-only "Contents" access to it.
# UPDATE_REPO=owner/name
# GITHUB_TOKEN=github_pat_...
