TZ=Australia/Brisbane
# Which ready-made image to follow: latest (releases), beta (pre-releases too), or a version like 0.7.0.
# IMAGE_TAG=latest
# The password between the app and its updater container (any text).
# UPDATER_TOKEN=change-me
# Everything below can also be set in the app (Settings → Advanced).
# Whatever is set here wins over the app.
# SECURE_COOKIES=true
# Only if you open the app through your own domain (reverse proxy, Cloudflare Tunnel):
# ALLOWED_HOSTS=budget.example.com
# Only behind a reverse proxy, so the login limit sees real visitor addresses:
# TRUST_PROXY=1
# Only needed to run a second copy (e.g. a test one) on the same machine:
# CONTAINER_NAME=simple-budget-test
# HOST_PORT=3001
# APP_CHANNEL=test

# Only for a private fork: where to look for new versions (Settings → Updates),
# and a fine-grained token with read-only "Contents" access to it.
# UPDATE_REPO=owner/name
# GITHUB_TOKEN=github_pat_...
